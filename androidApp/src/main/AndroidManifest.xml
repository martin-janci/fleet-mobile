<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      "Notify me when a session needs me" (Settings, off until turned on): a
      foreground service holds the hub's event stream open while the app is
      away and posts a notification when a session comes to need the person.
      POST_NOTIFICATIONS is asked for when the person turns it on, and at no
      other moment. `specialUse`: no named type is "watch a server for a
      person". See `NeedsYouService`.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Pairing by QR. Declared by the app rather than by `:shared`, because the
      permissions an app asks for are the app's own to declare — and `required="false"`
      because the app must install and work on a device with no camera at all:
      the pairing code can always be typed. See `ui/scan/QrScanner.kt`.

      Declaring the permission is not asking for it. It is requested when the
      scanner is opened by a tap on the Pair screen, and at no other moment, so
      a fresh install does not greet anyone with a camera dialog and someone who
      means to type the eight characters never sees one at all. `PairScreen` and
      `PairViewModel` say why; `AndroidHostTest` is what stops it drifting back.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      The app's own update (redesign 14.18, MobileUpdate): the signed release
      APK from GitHub, checked against the installed app's signing key and
      handed to Android's installer, which asks the person to confirm every
      time. Android also asks, once, before letting the app install at all.
      Nothing installs without those taps. See `AndroidAppInstaller`.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      This phone's lock (redesign 14.11): the system's fingerprint or face
      check when the app opens and before an answer, only while the person has
      the lock on. An install-time permission; the app never sees a
      fingerprint, only whether the check passed. See `PhoneLock.android.kt`.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      The composer's mic (MobileSession): the system's speech recogniser,
      started as an activity that asks for the microphone itself — so no
      RECORD_AUDIO here. Android 11+ hides other apps' activities from a
      lookup unless they are named, and the mic is drawn only when a
      recogniser is found. See `Dictation.android.kt`.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!--
      The credential must not leave the device it was issued to, and cannot
      survive being restored onto another one anyway: the Keystore master key
      that decrypts `EncryptedSharedPreferences` is not restorable with the file.
      `allowBackup` covers Auto Backup; `dataExtractionRules` covers API 31+
      cloud backup *and* device-to-device transfer, which `allowBackup` does not.
      See `res/xml/data_extraction_rules.xml`.
    -->
    <!--
      `FleetApplication` owns the one `AppContainer`, so an activity that is
      recreated picks the same paired session, drafts and lock state back up.
    -->
    <application
        android:name=".FleetApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FleetMobile"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <!--
          `singleTop` so a second `claudefleet:` link reaches the activity that
          is already showing, through `onNewIntent`, instead of stacking a
          second copy of it on top of the first.

          This was not a style choice. Under the default `standard` mode the
          emulator showed the override never running at all: after a second
          `am start`, the activity was still holding the first URL. So the
          second link was silently ignored by the screen the person was looking
          at, and Back returned to a stale Pair screen holding the previous
          code — the case an agent hits the moment it re-runs a setup script.
          `PairLinkRoutingTest.a_second_link_reaches_the_same_activity` is that
          scenario, and it fails without this attribute.

          `adjustResize` is the other attribute that is not a style choice.
          Declare nothing and the activity gets ADJUST_UNSPECIFIED, which lets
          the system choose — and what it chooses is to PAN the window when the
          keyboard opens. `App` already raises the prompt box itself, because it
          pads the whole app with `WindowInsets.safeDrawing` and that contains
          the IME inset. With the pan on top, the screen travelled twice the
          height of the keyboard and the session's top bar walked off it.

          The value works *with* `enableEdgeToEdge()` rather than against it:
          edge-to-edge clears `decorFitsSystemWindows`, so `adjustResize` no
          longer resizes the window at all — it dispatches the IME as an inset
          and leaves the single padding in `App` as the one and only movement.
          `KeyboardInsetsTest` is the gate; the iOS half of the same property
          is in `MainViewController.kt`.

          `configChanges` lists everything Compose re-reads on its own
          (`LocalConfiguration`, `LocalDensity`): a rotation, split screen or a
          fold (`screenSize` needs `smallestScreenSize|screenLayout` with it),
          a font-size or display-size change, a language change, a keyboard.
          Any one left out recreates the activity, and with it every screen's
          `remember` — the open session, a half-filled New session form.
          `AndroidHostTest` holds the list.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|locale|layoutDirection|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Pairing from a link instead of a camera: `claudefleet:` carries
              the same URL the QR encodes, so a hub's printed pair URL becomes a
              link by prefixing it. See `data/PairLink.kt`.

                adb shell am start -a android.intent.action.VIEW \
                  -d "claudefleet:https://fleet.example.com/pair#ABCDEFGH"

              A link never pairs a release build on its own — it fills the two
              fields on the Pair screen and somebody taps. A link is something
              anyone can send, and a silent pair would re-point the app at a hub
              of the sender's choosing. `BROWSABLE` is deliberately absent: this
              is for tooling and for a tap on a link the operator already has,
              not for arbitrary web pages to launch.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="claudefleet" />
            </intent-filter>
        </activity>

        <!--
          The Files tab's Share and Open (`FileHandoff.android.kt`): a file the
          app downloaded from the hub leaves it as a `content://` URI with a
          one-off read grant — Android refuses a `file://` path across apps.
          Not exported; `res/xml/file_paths.xml` exposes only
          `cache/downloads/`, where those copies live, and nothing else of the
          app's storage. The authority is `<applicationId>.files`, so a debug
          build (`.debug`) and a release build each name their own, and the
          code builds the same string from `packageName`.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- The install session's status: opens Android's confirm screen. Not exported. -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />
        <service
            android:name=".NeedsYouService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a connection to the person's own fleet hub open to tell them when an agent session needs them." />
        </service>
    </application>

</manifest>

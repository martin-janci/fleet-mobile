<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher glyph: a shell prompt.

  An adaptive icon's foreground is 108x108dp of which only the middle 66x66 is
  guaranteed to be visible — every launcher masks the rest to its own shape, and
  some of them animate the two layers apart. So the mark sits inside x,y 30..78,
  which survives a circle, a squircle and a teardrop alike.

  Drawn rather than drawn-over-a-bitmap: a vector is a few hundred bytes, scales
  to every density without five PNGs, and doubles as the API 33 monochrome layer
  where the system takes the silhouette and tints it itself.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M34,40 L50,54 L34,68"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M56,68 L74,68"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
</vector>
